# =============================================================================
# Application
# =============================================================================
APP_NAME="Employee Management SaaS"
APP_ENV="development"       # development | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# =============================================================================
# Database
# =============================================================================
# Full async connection string for SQLAlchemy + asyncpg
DATABASE_URL="postgresql+asyncpg://empuser:emppassword@localhost:5432/employee_management"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=true          # Set to false in production

# =============================================================================
# Authentication / JWT
# =============================================================================
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="REPLACE_WITH_STRONG_RANDOM_SECRET_AT_LEAST_256_BITS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# =============================================================================
# Email
# =============================================================================
EMAIL_PROVIDER="smtp"       # smtp | sendgrid | resend
EMAIL_FROM_ADDRESS="noreply@yourapp.com"
EMAIL_FROM_NAME="Employee Management"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=false

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins. Use * for development only.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL="DEBUG"           # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT="console"        # console (dev) | json (production)

# =============================================================================
# Background Jobs / Scheduler
# =============================================================================
SCHEDULER_ENABLED=true
# Cron: mark absent employees — runs at 23:30 UTC daily
ABSENCE_MARK_CRON="30 23 * * *"
# Cron: leave allocation check — runs at 00:05 on 1st of each month
LEAVE_ALLOCATION_CRON="5 0 1 * *"
